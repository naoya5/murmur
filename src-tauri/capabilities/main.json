{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-app-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-input-devices",
    "allow-get-dashboard",
    "allow-list-history",
    "allow-delete-history-item",
    "allow-clear-history",
    "allow-retry-history-item",
    "allow-copy-text",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model",
    "allow-get-permissions",
    "allow-request-microphone",
    "allow-request-accessibility",
    "allow-open-privacy-pane",
    "allow-suspend-hotkeys",
    "allow-resume-hotkeys",
    "allow-reset-stats",
    "allow-toggle-recording",
    "allow-open-url",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-open-annotations-folder"
  ]
}
